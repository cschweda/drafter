{
  "name": "@drafter/desktop",
  "version": "0.9.0",
  "private": true,
  "productName": "Drafter",
  "description": "Drafter for the desktop: the drafter.dev app in an Electron window, from its own files.",
  "author": "Christopher Schweda <cschweda@gmail.com>",
  "homepage": "https://drafter.dev",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsdown",
    "build:web": "node scripts/build-web.mjs",
    "start": "electron .",
    "dev": "pnpm build && pnpm build:web && electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "tsdown && playwright test",
    "package": "electron-builder --config electron-builder.config.cjs --linux --publish never",
    "package:mac": "electron-builder --config electron-builder.config.cjs --mac --publish never",
    "package:win": "electron-builder --config electron-builder.config.cjs --win --publish never",
    "dist": "pnpm build && pnpm build:web && pnpm package",
    "desktop:mac": "pnpm build && pnpm build:web && pnpm package:mac",
    "desktop:win": "pnpm build && pnpm build:web && pnpm package:win",
    "e2e:packaged": "playwright test --config playwright.packaged.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "desktopName": "drafter.desktop"
}
