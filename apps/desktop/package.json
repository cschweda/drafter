{
  "name": "@drafter/desktop",
  "version": "0.3.0",
  "private": true,
  "productName": "Drafter",
  "description": "Drafter for the desktop: the drafter.dev app in an Electron window, from its own files.",
  "author": "Christopher Schweda <cschweda@gmail.com>",
  "homepage": "https://drafter.dev",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsdown",
    "build:web": "node scripts/build-web.mjs",
    "start": "electron .",
    "dev": "pnpm build && pnpm build:web && electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "tsdown && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "45.0.0"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
