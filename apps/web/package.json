{
  "name": "@drafter/web",
  "private": true,
  "type": "module",
  "description": "drafter.dev: the Drafter app, built with Nuxt as static files.",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/sync-assets.mjs && nuxt dev",
    "build": "node scripts/sync-assets.mjs && nuxt generate && node scripts/csp.mjs .output/public && node scripts/check-build.mjs .output/public",
    "preview": "node scripts/serve.mjs .output/public 4173",
    "e2e": "rm -rf .output && DRAFTER_TEST_MODULES=1 NETLIFY=true pnpm build && playwright test",
    "test": "vitest run",
    "typecheck": "nuxt typecheck && vue-tsc --noEmit -p ../../modules/tsconfig.json",
    "postinstall": "nuxt prepare",
    "e2e:a11y": "rm -rf .output && DRAFTER_TEST_MODULES=1 NETLIFY=true pnpm build && A11Y=1 playwright test --grep \"accessibility violations\""
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@drafter/cm-fountain": "workspace:*",
    "@drafter/fountain": "workspace:*",
    "@drafter/layout": "workspace:*",
    "@drafter/lint": "workspace:*",
    "@drafter/render-html": "workspace:*",
    "@drafter/render-pdf": "workspace:*",
    "@drafter/render-text": "workspace:*",
    "@drafter/templates": "workspace:*",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.147",
    "@nuxt/ui": "^4.12.0",
    "@vueuse/core": "^14.4.0",
    "dexie": "^4.4.7",
    "mdast-util-from-markdown": "^2.1.0",
    "nuxt": "^4.6.2",
    "nuxt-guided-tour": "^0.5.1",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "fake-indexeddb": "^6.2.6",
    "vue-tsc": "^3.3.13"
  }
}
