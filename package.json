{
  "name": "drafter",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "pnpm -r build",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "check": "biome check .",
    "test-counts": "node scripts/test-counts.mjs",
    "diagrams": "node scripts/diagrams.mjs",
    "drafter": "node packages/cli/dist/index.js",
    "dev": "pnpm --filter @drafter/web dev",
    "e2e": "pnpm --filter @drafter/web e2e",
    "desktop:dev": "pnpm --filter @drafter/desktop dev",
    "desktop:dist": "pnpm --filter @drafter/desktop dist",
    "desktop:mac": "pnpm --filter @drafter/desktop desktop:mac",
    "desktop:win": "pnpm --filter @drafter/desktop desktop:win"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "pdfjs-dist": "^6.4.299",
    "tsdown": "^0.23.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
