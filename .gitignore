# Dependencies
node_modules/

# Build output
dist/
.output/
.nuxt/
.nitro/
.netlify/
.cache/
*.tsbuildinfo

# Tests
coverage/

# Scripts built from the samples and fixtures
samples/*.pdf
fixtures/**/*.pdf

# Logs
*.log

# Environment
.env
.env.*
# Secrets never go in the repository; a sample with no real values may.
!.env.example
!.env.sample

# OS
.DS_Store
._*
Thumbs.db

# Editors: shared VS Code settings are allowed; everything else (including
# extension logs such as .server-controller-port.log) stays local.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/

# Brainstorming mockups (superpowers visual companion)
.superpowers/

# Other apps' files, which only the maintainer's local tests may read (DRAFTER_REAL_FILES)
*.highland
*.fadein
