{
  "name": "@drafter/production",
  "version": "0.26.2",
  "description": "Production for Drafter: locked pages and scene numbers, and colored revision sets, kept in the script's own file.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cschweda/drafter.git",
    "directory": "packages/production"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@drafter/cast": "workspace:*",
    "@drafter/compare": "workspace:*",
    "@drafter/fountain": "workspace:*",
    "@drafter/layout": "workspace:*",
    "@drafter/outline": "workspace:*",
    "@drafter/templates": "workspace:*"
  }
}
