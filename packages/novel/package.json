{
  "name": "@drafter/novel",
  "version": "0.26.0",
  "description": "Drafter's Novel: reads the parts, chapters, and sections of a novel written in Markdown.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cschweda/drafter.git",
    "directory": "packages/novel"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@drafter/markdown": "workspace:*"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.6"
  }
}
