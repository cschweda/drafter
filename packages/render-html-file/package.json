{
  "name": "@drafter/render-html-file",
  "version": "0.20.0",
  "description": "Drafter's HTML export: a script or a Markdown document as one self-contained, offline .html file, dark by default, with a light switch.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cschweda/drafter.git",
    "directory": "packages/render-html-file"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@drafter/archive": "workspace:*",
    "@drafter/fountain": "workspace:*",
    "@drafter/layout": "workspace:*",
    "@drafter/markdown": "workspace:*",
    "@drafter/notes": "workspace:*",
    "@drafter/outline": "workspace:*",
    "@drafter/templates": "workspace:*"
  }
}
