{
  "name": "@drafter/render-docx",
  "version": "0.26.2",
  "description": "Word output for Drafter: writes a novel's standard manuscript as a .docx, by hand.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cschweda/drafter.git",
    "directory": "packages/render-docx"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@drafter/archive": "workspace:*",
    "@drafter/novel": "workspace:*",
    "@drafter/templates": "workspace:*"
  },
  "devDependencies": {
    "@drafter/markdown": "workspace:*"
  }
}
