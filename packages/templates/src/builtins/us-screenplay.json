{
  "id": "us-screenplay",
  "name": "US Screenplay (Feature)",
  "page": {
    "paper": "letter",
    "width": 85,
    "height": 66,
    "margin": { "top": 6, "bottom": 6, "left": 15, "right": 10 },
    "font": { "family": "Courier Prime", "monospace": true, "pt": 12 },
    "numbering": { "position": "top-right", "line": 3, "firstNumbered": 2, "format": "{n}." }
  },
  "roles": {
    "scene_heading": {
      "indent": 0,
      "width": 60,
      "case": "upper",
      "spaceBefore": 2,
      "keepWithNext": true,
      "heading": 2
    },
    "action": { "indent": 0, "width": 60, "spaceBefore": 1 },
    "character": {
      "indent": 22,
      "width": 33,
      "case": "upper",
      "spaceBefore": 1,
      "keepWithNext": true
    },
    "parenthetical": { "indent": 16, "width": 25, "spaceBefore": 0, "keepWithNext": true },
    "dialogue": { "indent": 10, "width": 35, "spaceBefore": 0 },
    "lyric": { "indent": 10, "width": 35, "spaceBefore": 1, "style": { "italic": true } },
    "transition": {
      "indent": 40,
      "width": 20,
      "case": "upper",
      "align": "right",
      "spaceBefore": 1
    },
    "centered": { "indent": 0, "width": 60, "align": "center", "spaceBefore": 1 }
  },
  "roleMap": [
    { "kind": ["section", "synopsis", "note", "boneyard"], "role": "omit" },
    { "kind": "*", "role": "@kind" }
  ],
  "keepWithNextLines": 2,
  "dialogueSplit": {
    "more": "(MORE)",
    "contd": "(CONT'D)",
    "moreIndent": 22,
    "minLinesBefore": 2,
    "minLinesAfter": 2,
    "contdAfterAction": true
  },
  "dual": {
    "gap": 4,
    "width": 28,
    "indent": { "character": 8, "parenthetical": 4, "dialogue": 0 }
  },
  "sceneNumbers": { "enabled": false, "left": -10, "right": 61 },
  "titlePage": { "layout": "centered-feature" }
}
