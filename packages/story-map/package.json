{
  "name": "@drafter/story-map",
  "version": "0.24.1",
  "description": "Drafter's Story map: one dark, script-free HTML page that shows a non-writer a screenplay or stage play at a glance.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cschweda/drafter.git",
    "directory": "packages/story-map"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "dist",
    "fonts"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@drafter/cast": "workspace:*",
    "@drafter/fountain": "workspace:*",
    "@drafter/layout": "workspace:*",
    "@drafter/notes": "workspace:*",
    "@drafter/outline": "workspace:*",
    "@drafter/render-html-file": "workspace:*",
    "@drafter/templates": "workspace:*"
  }
}
