      </Paragraph>
      <Paragraph Alignment="Center" LeftIndent="1.00" StartsNewPage="No">
        <Text></Text>
      </Paragraph>
      <Paragraph Alignment="Center" LeftIndent="1.00" StartsNewPage="No">
        <Text>Written by</Text>
      </Paragraph>
      <Paragraph Alignment="Center" LeftIndent="1.00" StartsNewPage="No">
