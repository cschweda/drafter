      <Paragraph Type="Header">
        <Text>The Spare Key - draft two</Text>
      </Paragraph>
    </Header>
  </HeaderAndFooter>

  <SmartType>
    <Characters>
      <Character>DOV</Character>
      <Character>RAINCOAT</Character>
      <Character>WREN</Character>
    </Characters>
