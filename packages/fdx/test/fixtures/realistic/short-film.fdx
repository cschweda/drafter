      <Transition>CUT TO:</Transition>
      <Transition>SMASH CUT TO:</Transition>
    </Transitions>
  </SmartType>

  <Revisions Current="1">
    <Revision Color="#000000" ID="1" Name="Draft two"/>
  </Revisions>

  <Macros>
    <Macro Name="interior" Text="INT. "/>
  </Macros>

  <ScriptNotes>
    <ScriptNote ID="1">
      <Paragraph Type="General">
        <Text>Is the anchor too neat? Maybe the stamp is worn, half there.</Text>
      </Paragraph>
    </ScriptNote>
    <ScriptNote ID="2">
      <Paragraph Type="General">
        <Text>Give Dov one more beat of wanting to go.</Text>
      </Paragraph>
    </ScriptNote>
  </ScriptNotes>

  <TagData>
    <Tag Id="t1" Label="brass key">
      <Ref>tag-ref-0001</Ref>
    </Tag>
