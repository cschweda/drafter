    <Writer Name="S. Lindqvist">first pass</Writer>
  </Writers>
  <WriterMarkup Visible="No"/>
  <Navigator>
    <Tab>Scenes</Tab>
  </Navigator>
  <Outlines>
    <Outline Name="Acts">invented outline settings</Outline>
  </Outlines>
  <TargetScriptLength>95</TargetScriptLength>
  <Characters>
    <Character Name="ODA">
      <Trait>stubborn, kind to dogs</Trait>
    </Character>
  </Characters>

  <AltCollection>
    <Alt Id="alt-01">
      <Paragraph Type="Action">
        <Text>Fog on the water. A diesel engine coughs somewhere upstream.</Text>
      </Paragraph>
    </Alt>
    <Alt Id="alt-02">
      <Paragraph Type="Action">
        <Text>Thick fog. Upstream, an engine where no engine should be.</Text>
      </Paragraph>
    </Alt>
    <Alt Id="alt-03">
      <Paragraph Type="Dialogue">
        <Text>Let me through, keeper.</Text>
      </Paragraph>
    </Alt>
    <Alt Id="alt-04">
      <Paragraph Type="Dialogue">
        <Text>Open up! I've a cargo that won't keep.</Text>
      </Paragraph>
    </Alt>
    <Alt Id="alt-99">
      <Paragraph Type="Action">
        <Text>An alternate line no paragraph points to.</Text>
      </Paragraph>
    </Alt>
  </AltCollection>

  <ListItems>
    <ListItem Color="#336699" Id="beat-01" Title="The boat that shouldn't exist" Type="Beat">
      <SubordinateTo Id="beat-00"/>
      <Content>
        <Paragraph>
          <Text>Registered to a yard that closed in the sixties.</Text>
        </Paragraph>
        <Paragraph>
          <Text>Its paint is still wet.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Color="#993366" Id="beat-02" Title="" Type="Beat">
      <Content>
        <Paragraph>
          <Text>Oda finds her father's handwriting in the boat's log.</Text>
        </Paragraph>
      </Content>
    </ListItem>
  </ListItems>

  <ScriptNotes>
    <ScriptNote Color="#FFCC00" Id="note-01" Range="120,168" WriterName="S. Lindqvist">
      <Paragraph>
        <Text>Is the fog doing too much work here?</Text>
      </Paragraph>
    </ScriptNote>
    <ScriptNote Color="#FFCC00" Id="note-02" Range="300,341">
      <Paragraph>
        <Text>Fenn needs a reason to say nine.</Text>
      </Paragraph>
    </ScriptNote>
  </ScriptNotes>

  <Images>
    <Image Id="pic-01" Length="32" Path="lock-diagram.png">aW52ZW50ZWQgaW1hZ2UgYnl0ZXMgZm9yIGEgdGVzdA==</Image>
