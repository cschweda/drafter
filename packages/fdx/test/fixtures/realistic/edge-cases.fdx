    </Paragraph>
    <Paragraph>
      <DualDialogue>
        <Paragraph Type="Character">
          <Text>INÈS (O.S.)</Text>
        </Paragraph>
        <Paragraph Type="Parenthetical">
          <Text>(calling)</Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
          <Text>Found it!</Text>
        </Paragraph>
        Both at once, over each other.
        <Paragraph Type="Character">
          <Text>mrs. okafor</Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
          <Text>Don't touch it!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Shot">
      <Text>INSERT - THE FUSE BOX</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <Text>(the dark)</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Alignment="Center" Type="Action">
      <Text>THE END</Text>
    </Paragraph>
  </Content>
