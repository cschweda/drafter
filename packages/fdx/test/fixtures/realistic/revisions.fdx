  <ScriptNotes>
    <ScriptNote Color="#FFFFE0E07070" ID="1" Range="210,231" Writer="I. Penhallow">
      <Paragraph Type="General">
        <Text>Production: is the yard practical, or a set?</Text>
      </Paragraph>
    </ScriptNote>
  </ScriptNotes>
