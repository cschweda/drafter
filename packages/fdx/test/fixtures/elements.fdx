    <Paragraph Type="Action">
      <Text>Wind </Text>
      <Text Style="Bold">rattles</Text>
      <Text> the glass. A </Text>
      <Text Style="Italic">slow</Text>
      <Text> creak, then </Text>
      <Text Style="Underline">silence</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ODILE (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(from below)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Is the keeper awake?</Text>
    </Paragraph>
    <Paragraph Type="Transition">
