{
  "name": "@drafter/render-text",
  "version": "0.5.0",
  "description": "Plain-text output for Drafter: writes laid-out pages as fixed-width text.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cschweda/drafter.git",
    "directory": "packages/render-text"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@drafter/layout": "workspace:*",
    "@drafter/templates": "workspace:*"
  },
  "devDependencies": {
    "@drafter/fountain": "workspace:*"
  }
}
